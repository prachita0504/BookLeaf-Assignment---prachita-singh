# Copy to backend/.env and fill in. Never commit the real .env file.

# --- App ---
APP_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# --- MongoDB ---
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bookleaf_support

# --- Auth ---
# Long random string. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# --- AI (Groq). Server-side only, never sent to the frontend ---
# Models are configurable: any chat model listed at https://console.groq.com/docs/models works.
# Free key: https://console.groq.com/keys . Leave empty to run in rules-only fallback mode.
GROQ_API_KEY=
GROQ_CLASSIFY_MODEL=openai/gpt-oss-20b
GROQ_DRAFT_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20

# --- Login credentials (used by: python -m scripts.seed) ---
# Change any email/password here, then re-run the seed to apply it.

# Admin (BookLeaf team)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
# Default password for any author without its own AUTHxxx_PASSWORD below
AUTHOR_PASSWORD=author123

# Authors from data/bookleaf_sample_data.json (AUTHxxx = author_id in the JSON)
